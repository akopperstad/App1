{
  "name": "pulse-timer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "android:open": "cap open android",
    "ios:open": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
