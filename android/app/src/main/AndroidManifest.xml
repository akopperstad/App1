<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Shared-workout deep links: pulsetimer://import?w=<code> (or #w=<code>).
                 Opened by the "Open in Pulse" button on site/w/. launchMode singleTask
                 (above) delivers them to the running activity -> App "appUrlOpen".
                 Parsed by src/native/deepLinks.ts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pulsetimer" android:host="import" />
            </intent-filter>

            <!-- Verified App Links for https://<share host>/w/ are opt-in: build with
                 -PpulseShareHost=your-domain (or PULSE_SHARE_HOST) and the filter in
                 src/applinks/AndroidManifest.xml is merged in. See docs/RELEASE.md. -->

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background workout cues: local notifications at each work/rest boundary while the
         phone is locked. Runtime-requested (Android 13+) the first time a timer starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact timing for those cues (a cue 30 s late is useless in a 20/10 Tabata).
         Android 13+: USE_EXACT_ALARM, which Play allows for apps whose core function is a
         timer/alarm (Pulse is a workout timer) - declare it in Play Console > App content.
         Android 12/12L: SCHEDULE_EXACT_ALARM (granted at install there). It is capped at
         API 32 so Android 14+ never shows the "Alarms & reminders" special-access prompt.
         See docs/RELEASE.md, "Exact alarms". -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Haptic cues. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
