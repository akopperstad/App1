# Copy to android/keystore.properties (gitignored) for local release builds.
# Keep the keystore outside the repo; relative paths resolve from android/. CI can use env vars instead:
# PULSE_KEYSTORE_FILE, PULSE_KEYSTORE_PASSWORD, PULSE_KEY_ALIAS, PULSE_KEY_PASSWORD
storeFile=/home/you/keys/pulse-upload.jks
storePassword=change-me
keyAlias=pulse-upload
keyPassword=change-me
